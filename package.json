{
  "name": "yunima",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YouTube Animations — un estudio de animación por capas, en tu navegador.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "deploy": "npm run check && wrangler pages deploy dist --project-name yunima --branch main"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4",
    "wrangler": "4.45.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
